# ============================================================================
# BROKER MQTT (MOSQUITTO) — REDE E PORTAS
# ============================================================================
MQTT_BROKER=mosquitto
MQTT_PORT=8883
MQTT_TOPIC_WILDCARD=elo5/#

# ============================================================================
# TLS / mTLS (CERTIFICADOS MONTADOS NOS CONTAINERS)
# ============================================================================
MQTT_TLS_ENABLED=true
MQTT_TLS_INSECURE=false
MQTT_CA_CERT=/app/certs/ca.crt
MQTT_CLIENT_CERT=/app/certs/api.crt
MQTT_CLIENT_KEY=/app/certs/api.key

# ============================================================================
# CREDENCIAIS MQTT (USADAS PELO MAKEFILE, DOCKER COMPOSE E SERVIÇOS)
# ============================================================================
MQTT_HEALTH_USER=healthcheck
MQTT_HEALTH_PASS=TROQUE_SENHA_HEALTHCHECK

MQTT_API_USER=elo5api
MQTT_API_PASSWORD=TROQUE_SENHA_API

MQTT_SIM_USER=elo5sim
MQTT_SIM_PASSWORD=TROQUE_SENHA_SIMULADOR

MQTT_ESP_USER=esp32_cpd_01
MQTT_ESP_PASS=TROQUE_SENHA_ESP32

# ============================================================================
# PERSISTÊNCIA DA ELO5API (SQLITE)
# ============================================================================
DATABASE_URL=sqlite:////data/elo5system.db

# ============================================================================
# SEGURANÇA DA API WEB / ENDPOINTS DE ESCRITA (OPCIONAL)
# ============================================================================
# Se preenchido, exige header X-API-Key em POST /api/v1/credentials e /events/ingest
API_ADMIN_KEY=
